ive)."], ["group 3 innate lymphoid cell vs T cell / NK cell", ["natural killer cell"], "ILC3s are the Lin- (Cd3-negative) RORgt+ compartment; Rorc is shared with Th17 cells and Ncr1 with NK cells (PMID 40585371)."]], "oq": ["MOUSE_LARGE_INTESTINE:0000022", "MOUSE_LARGE_INTESTINE:0000048", "MOUSE_LARGE_INTESTINE:0000025", "MOUSE_LARGE_INTESTINE:0000003"], "ca": [{"name": "intestinal crypt-axis mesenchyme zonation (crypt-bottom trophocyte <-> crypt-top telocyte)", "applies_to": ["fibroblast"], "poles": [{"pole": "crypt-bottom (sub-cryptal / pericryptal, BMP-antagonist Wnt niche)", "context_markers": ["Grem1", "Cd81", "Ptgs2", "Pdgfra-low"], "subtypes": {"fibroblast": "Crypt-bottom fibroblast"}}, {"pole": "crypt-top (telocyte, crypt-villus junction, BMP reservoir)", "context_markers": ["Pdgfra-high", "Foxl1", "Bmp2", "Bmp4", "Bmp7"], "subtypes": {"fibroblast": "Crypt-top fibroblast (telocyte)"}}], "pmids": ["32084389", "32322056"], "lineage": "fibroblast"}], "sa": [{"name": "osteoclastogenic RANKL program", "markers": ["TNFSF11", "ETS1"], "pmids": ["40136507", "38554844"], "applies_to": ["mesenchymal cell"], "mimics": [], "anchor_markers": [], "of": []}, {"name": "emergency-myelopoiesis immunosuppressive monocyte (MS1)", "markers": ["S100A12", "RETN", "PLAC8", "IL1R2", "VCAN", "ALOX5AP"], "pmids": ["32066974"], "applies_to": ["monocyte"], "mimics": [], "anchor_markers": [], "of": []}, {"name": "proliferating", "markers": ["MKI67", "TOP2A", "CCNB1", "CENPF"], "pmids": ["12058064"], "applies_to": [], "mimics": [], "anchor_markers": [], "of": ["adipose stem and progenitor cell", "myofibroblast", "endothelial cell", "macrophage", "fibroblast", "basal keratinocyte", "basal cell", "group 2 innate lymphoid cell", "skeletal muscle satellite cell"]}, {"name": "NETosis", "markers": ["PADI4", "ARG1", "MPO", "S100A8"], "pmids": ["32740860"], "applies_to": ["neutrophil"], "mimics": [], "anchor_markers": [], "of": []}, {"name": "immunomodulatory", "markers": ["LIF", "IL6", "IL11"], 