project('ssaft', 'cpp',
  version: '0.1.0',
  license: 'BSD-3-Clause',
  meson_version: '>= 0.64.0',
  default_options: [
    'buildtype=release',
    'cpp_std=c++17',
    'warning_level=2',
  ]
)

# Python (meson-python provides the Python module without explicit dependency)
py = import('python').find_installation('python3', pure: false)

# OpenMP (optional)
openmp_dep = dependency('openmp', required: get_option('openmp'))

# numpy include directory
incdir_numpy = run_command(py,
  ['-c', 'import numpy; print(numpy.get_include())'],
  check: true
).stdout().strip()

cpp_args = []
link_args = []

# SIMD (AVX-512F) — auto-enabled on x86_64
simd_opt = get_option('simd')
if simd_opt.enabled() or (simd_opt.auto() and host_machine.cpu_family() == 'x86_64')
  cpp_args += ['-mavx512f']
  link_args += ['-mavx512f']
endif

if get_option('buildtype') == 'release'
  cpp_args += ['-O3']
  if get_option('fast-math')
    cpp_args += ['-ffast-math']
  endif
  if get_option('native-arch')
    cpp_args += ['-march=native']
  endif
endif

if get_option('debug-symbols')
  cpp_args += ['-g']
endif

# C++ extension module (compiled from ssaft/_core/utils.cpp; installed as ssaft.utils)
utils_ext = py.extension_module('utils',
  sources: ['ssaft/_core/utils.cpp'],
  include_directories: [
    include_directories(incdir_numpy),
  ],
  dependencies: [openmp_dep],
  cpp_args: cpp_args,
  link_args: link_args,
  install: true,
  subdir: 'ssaft'
)

# Pure-Python package sources
py.install_sources([
  'ssaft/__init__.py',
  'ssaft/_analysis.py',
  'ssaft/_dataset.py',
  'ssaft/_kde_gpu.py',
  'ssaft/_mapping_gpu.py',
  # count-based (blur) backend
  'ssaft/_griddataset.py',
  'ssaft/_panel.py',
  'ssaft/_count.py',
  'ssaft/_gnb.py',
  'ssaft/_mapping_inputs.py',
], subdir: 'ssaft')

# count-based loaders subpackage
py.install_sources([
  'ssaft/_io/__init__.py',
  'ssaft/_io/_grid.py',
  'ssaft/_io/_loaders.py',
], subdir: 'ssaft/_io')
